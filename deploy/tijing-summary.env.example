# OpenAI-compatible chat-completions endpoint. DeepSeek example:
TIJING_LLM_BASE_URL=https://api.deepseek.com/v1
TIJING_LLM_API_KEY=replace-with-your-api-key
TIJING_LLM_MODEL=deepseek-chat

# Optional: when both values are set, callers must have a valid Supabase login.
# TIJING_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# TIJING_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

TIJING_SUMMARY_PORT=8787
TIJING_RATE_LIMIT=12
TIJING_ALLOWED_ORIGINS=https://tijing.wannafly.cn,https://code92007.github.io,http://127.0.0.1:4173,null
