[Unit]
Description=Tijing problem statement summary API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/tijing
EnvironmentFile=/etc/tijing-summary.env
ExecStart=/usr/bin/node /root/tijing/api/problem-summary.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
